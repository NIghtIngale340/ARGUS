# ARGUS local demo environment.
# These values are for localhost-only development. Change every key before any
# network-exposed deployment.

# Core services
ES_URL=http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200
KAFKA_BOOTSTRAP=localhost:29092
REDIS_URL=redis://localhost:6379/0
MLFLOW_URI=http://localhost:5000

# API security
ARGUS_API_KEY=change-me-local-demo-key
ARGUS_ADMIN_API_KEY=change-me-local-admin-key
ARGUS_DASHBOARD_USERNAME=argus
ARGUS_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ARGUS_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
ARGUS_MAX_REQUEST_BYTES=1048576
ARGUS_RATE_LIMIT_ENABLED=true
ARGUS_RATE_LIMIT_PER_MINUTE=120
ARGUS_RATE_LIMIT_USE_REDIS=false
ARGUS_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Phase 3 runtime
ARGUS_PHASE3_BUNDLE_DIR=data/argus_phase3_model_bundle
ARGUS_PHASE3_THRESHOLD=
ARGUS_USE_REDIS_UEBA=true
ARGUS_USE_ELASTICSEARCH_ALERTS=true
ARGUS_ALERT_INDEX_PREFIX=argus-alerts

# Streaming/replay
ARGUS_RAW_LOG_TOPIC=argus.raw-logs
ARGUS_DETECTIONS_TOPIC=argus.detections
ARGUS_DEAD_LETTER_TOPIC=argus.dead-letter
ARGUS_STREAM_SESSION_MAX_TOKENS=
ARGUS_STREAM_SESSION_TTL_SECONDS=1800
ARGUS_REPLAY_RUN_ID=

# Runtime settings
MODEL_NAME=argus-bert-finetuned
LOG_LEVEL=INFO
ENV=development
